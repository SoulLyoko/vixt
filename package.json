{
  "name": "vixt-framework",
  "version": "0.12.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp exec --parallel --filter ./packages/* vp pack",
    "build:all": "vpr --filter ./playground/* build",
    "build:docs": "vpr --filter docs build",
    "build:nitro": "vpr --filter test-nitro build",
    "build:app": "vpr --filter test-uni build:app",
    "build:h5": "vpr --filter test-uni build:h5",
    "build:mp": "vpr --filter test-uni build:mp",
    "build:react": "vpr --filter test-react build",
    "build:vue": "vpr --filter test-vue build",
    "clean:dist": "rimraf packages/*/dist --glob",
    "clean:node": "rimraf **/node_modules --glob",
    "dev:docs": "vpr --filter docs dev",
    "dev:nitro": "vpr --filter test-nitro dev",
    "dev:app": "vpr --filter test-uni dev:app",
    "dev:h5": "vpr --filter test-uni dev:h5",
    "dev:mp": "vpr --filter test-uni dev:mp",
    "dev:nuxt": "vpr --filter test-nuxt dev",
    "dev:void": "vpr --filter test-void dev",
    "dev:react": "vpr --filter test-react dev",
    "dev:vue": "vpr --filter test-vue dev",
    "prerelease": "vpr build && vp test && vpr test:vue",
    "preview:nitro": "vpr --filter test-nitro preview",
    "preview:docs": "vpr --filter docs preview",
    "release": "bumpp",
    "test:vue": "vpr --filter test-vue test",
    "upd": "taze major -r -l -I"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@vitest/browser-playwright": "catalog:vite",
    "bumpp": "catalog:",
    "playwright": "catalog:vite",
    "rimraf": "catalog:",
    "taze": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:vite-plus",
    "vite-plus": "catalog:vite-plus"
  },
  "commitlint": {
    "extends": "@commitlint/config-conventional"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.22.0"
}
