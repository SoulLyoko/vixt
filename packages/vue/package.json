{
  "name": "@vixt/vue",
  "version": "0.13.1",
  "keywords": [
    "vite",
    "vixt",
    "vue"
  ],
  "homepage": "https://soullyoko.github.io/vixt/",
  "license": "MIT",
  "author": "SoulLyoko<https://github.com/SoulLyoko>",
  "repository": "https://github.com/SoulLyoko/vixt.git",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/node/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": "./src/node/index.ts",
    "./client/App": "./src/client/App.vue",
    "./client/*": "./src/client/*.ts",
    "./types": "./src/types/index.d.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/node/index.mjs",
      "./client/App": "./dist/client/App.vue",
      "./client/*": "./dist/client/*.js",
      "./types": "./dist/types/index.d.ts",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@vitejs/plugin-vue": "catalog:vite",
    "@vitejs/plugin-vue-jsx": "catalog:vite",
    "@vixt/core": "workspace:*",
    "@vue/compiler-sfc": "catalog:vue",
    "defu": "catalog:",
    "fs-extra": "catalog:",
    "mlly": "catalog:",
    "pathe": "catalog:",
    "unplugin-vue-components": "catalog:vite",
    "vite": "catalog:vite",
    "vite-plugin-vue-devtools": "catalog:vite",
    "vite-plugin-vue-layouts": "catalog:vite",
    "vue": "catalog:vue",
    "vue-router": "catalog:vue",
    "vue-tsc": "catalog:vue"
  }
}
