{
  "name": "@vixt/uni",
  "version": "0.13.0",
  "keywords": [
    "uni",
    "uni-app",
    "uniapp",
    "vite",
    "vixt"
  ],
  "homepage": "https://soullyoko.github.io/vixt/",
  "license": "MIT",
  "author": "SoulLyoko<https://github.com/SoulLyoko>",
  "repository": "https://github.com/SoulLyoko/vixt.git",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/node/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": "./src/node/index.ts",
    "./client/*": "./src/client/*.ts",
    "./types": "./src/types/index.d.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/node/index.mjs",
      "./client/*": "./dist/client/*.js",
      "./types": "./dist/types/index.d.ts",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@dcloudio/types": "catalog:uni",
    "@uni-helper/uni-types": "catalog:uni",
    "@uni-helper/vite-plugin-uni-components": "catalog:uni",
    "@uni-helper/vite-plugin-uni-layouts": "catalog:uni",
    "@uni-helper/vite-plugin-uni-pages": "catalog:uni",
    "@vixt/core": "workspace:*",
    "defu": "catalog:",
    "fast-glob": "catalog:",
    "fs-extra": "catalog:",
    "mlly": "catalog:",
    "pathe": "catalog:",
    "vite": "catalog:uni",
    "vue": "catalog:vue"
  },
  "devDependencies": {
    "@dcloudio/vite-plugin-uni": "catalog:uni",
    "pinia": "catalog:vue"
  },
  "peerDependencies": {
    "@dcloudio/vite-plugin-uni": "*",
    "pinia": "*"
  }
}
